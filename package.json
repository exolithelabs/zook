{
  "name": "zook",
  "version": "0.1.0",
  "description": "A search app with an in-app browser",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/licenses.mjs",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "release:keygen": "node scripts/release.mjs keygen",
    "release:sign": "node scripts/release.mjs sign"
  },
  "build": {
    "appId": "app.zook",
    "productName": "Zook",
    "files": [
      "out/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "asarUnpack": [
      "out/licenses/LICENSES.chromium.html"
    ]
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.9",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "allowScripts": {
    "electron@45.4.1": true
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3"
  }
}
